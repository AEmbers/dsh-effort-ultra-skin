{
  "name": "dsh-effort-ultra-skin",
  "version": "0.1.1",
  "description": "DeepSeek Harness 推理档位皮肤：把 @hytime/dsh-thinking-effort 的推理等级控件重绘成蓝紫渐变、带星点与流光的档位条。 / A skin for the DSH reasoning-tier control: a blue→violet pill with a starfield and a sheen sweep.",
  "license": "MIT",
  "author": "LoveIrishCoffee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoveIrishCoffee/dsh-effort-ultra-skin.git"
  },
  "homepage": "https://github.com/LoveIrishCoffee/dsh-effort-ultra-skin#readme",
  "bugs": {
    "url": "https://github.com/LoveIrishCoffee/dsh-effort-ultra-skin/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
      "compatibility": {
        "dsh": ">=0.2.0-rc.1",
        "dshReleases": {
          "0.2.0-rc.1": "compatible",
          "0.2.0-rc.2": "compatible",
          "0.2.1-alpha.1": "compatible"
        }
      }
    },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/smoke-client.mjs && node scripts/check-package-contract.mjs",
    "check:dist": "npm run build && git diff --exit-code -- dist",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skin",
    "theme",
    "reasoning-effort",
    "thinking-effort",
    "web-ui"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  }
}
